# ParseKit Environment Configuration

# Server
SERVER_PORT=8000
JAVA_OPTS=-Xmx512m
LOG_LEVEL=INFO

# File Upload Limits
MAX_FILE_SIZE=20GB
MAX_REQUEST_SIZE=20GB

# JODConverter (LibreOffice) timeout in milliseconds
JODCONVERTER_TIMEOUT=120000

# Docling Service (document parsing)
# Comma-separated list of Docling server URLs for load balancing
# Example: http://docling1:5000,http://docling2:5000
DOCLING_BASE_URLS=
DOCLING_TIMEOUT=5m
DOCLING_MAX_BUFFER_SIZE=16777216

# VLM Service (Vision Language Model for OCR)
# Use indexed environment variables for multiple servers:
# PARSER_VLM_SERVERS_0_BASE_URL=http://vllm1:8000
# PARSER_VLM_SERVERS_0_MODEL=Qwen/Qwen2-VL-7B-Instruct
# PARSER_VLM_SERVERS_1_BASE_URL=http://vllm2:8000
# PARSER_VLM_SERVERS_1_MODEL=Qwen/Qwen2-VL-7B-Instruct
PARSER_VLM_SERVERS_0_BASE_URL=
PARSER_VLM_SERVERS_0_MODEL=
PARSER_VLM_TIMEOUT=2m
PARSER_VLM_MAX_BUFFER_SIZE=16777216
PARSER_VLM_MAX_TOKENS=4096
PARSER_VLM_TEMPERATURE=0.01
